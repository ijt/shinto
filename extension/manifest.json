{
  "manifest_version": 3,
  "name": "Shinto",
  "version": "0.1.3",
  "description": "One window, one page. Hyprland is the tab bar.",
  "key": "",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["tabs", "windows", "commands", "scripting", "history", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["complete.js", "overlay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "new-page": {
      "suggested_key": { "default": "Ctrl+T" },
      "description": "Open a new page (window)"
    },
    "focus-location": {
      "suggested_key": { "default": "Ctrl+L" },
      "description": "Edit this page's address"
    }
  }
}
